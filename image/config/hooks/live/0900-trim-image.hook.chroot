#!/bin/sh

set -eu

# APT's downloaded package indices and cache database are build-time-only
# (~180MB on the squashfs) and serve no purpose on the live system -- it
# re-fetches indices itself if the user installs anything post-boot.
rm -rf /var/lib/apt/lists/*
rm -f /var/cache/apt/*.bin
apt-get clean

# GPU firmware from firmware-misc-nonfree/firmware-linux-free. Tailboot
# never drives a display at any point in its boot, so this is dead weight
# regardless of what GPU the target hardware has. NIC/Wi-Fi firmware
# (iwlwifi, realtek) is untouched -- that's what actually matters here.
rm -rf /usr/lib/firmware/nvidia /usr/lib/firmware/amdgpu /usr/lib/firmware/radeon \
  /usr/lib/firmware/i915 /usr/lib/firmware/nouveau

# Switch/router ASIC firmware (e.g. Marvell Prestera, ~60MB). Tailboot is a
# live boot image for general x86-64 hardware, never a network switch.
rm -rf /usr/lib/firmware/mrvl

# Man pages, package docs, and non-English locale data are convenience-only
# and never needed for a text-mode SSH-accessed appliance.
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/*
if [ -d /usr/share/locale ]; then
  find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en*' -exec rm -rf {} +
fi

# Leftover build caches from the pip/pipx/cargo installs in the pentest-tools
# hook (~90MB): pip's HTTP cache and cargo's registry cache. Neither is
# consulted again once the packages they cached are installed.
rm -rf /root/.cache/pip /root/.cargo
