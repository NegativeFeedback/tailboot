#!/bin/sh

set -eu

# APT's package indices (~180MB) are dropped from the built image via
# --apt-indices false in image/auto/config, not here: live-build re-syncs
# /var/lib/apt/lists (and apt regenerates its cache database from that) as
# part of its own internal chroot_apt lifecycle, which runs after hooks --
# an rm here gets silently undone before the image is finalized.
apt-get clean

# GPU firmware from firmware-misc-nonfree/firmware-linux-free. Tailboot
# never drives a display at any point in its boot, so this is dead weight
# regardless of what GPU the target hardware has. NIC/Wi-Fi firmware
# (iwlwifi, realtek) is untouched -- that's what actually matters here.
rm -rf /usr/lib/firmware/nvidia /usr/lib/firmware/amdgpu /usr/lib/firmware/radeon \
  /usr/lib/firmware/i915 /usr/lib/firmware/nouveau /usr/lib/firmware/xe

# Switch/router and cloud SmartNIC ASIC firmware (Marvell Prestera, Netronome
# Agilio, Cavium LiquidIO -- ~150MB combined). Tailboot is a live boot image
# for general x86-64 hardware, never a network switch or a DPDK offload card.
rm -rf /usr/lib/firmware/mrvl /usr/lib/firmware/netronome /usr/lib/firmware/liquidio

# Audio, camera/image, AI/NPU, and sensor-hub firmware. Nothing in Tailboot
# touches audio, a camera, on-device inference, or platform sensors.
rm -rf /usr/lib/firmware/cirrus
rm -rf /usr/lib/firmware/intel/sof* /usr/lib/firmware/intel/avs \
  /usr/lib/firmware/intel/vsc /usr/lib/firmware/intel/vpu \
  /usr/lib/firmware/intel/ipu /usr/lib/firmware/intel/ish

# Bluetooth firmware. No bluetooth stack (bluez or otherwise) is installed
# anywhere in this image, so hardware Bluetooth is never brought up.
rm -f /usr/lib/firmware/intel/ibt-*

# Man pages, package docs, and non-English locale data are convenience-only
# and never needed for a text-mode SSH-accessed appliance.
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/*
if [ -d /usr/share/locale ]; then
  find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en*' -exec rm -rf {} +
fi

# Leftover build caches from the pip/cargo installs in the pentest-tools
# hook (~90MB): pip's HTTP cache and cargo's registry cache. Neither is
# consulted again once the packages they cached are installed.
rm -rf /root/.cache/pip /root/.cargo
