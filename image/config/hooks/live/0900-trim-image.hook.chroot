#!/bin/sh

set -eu

# APT's downloaded package indices and cache database are build-time-only
# (~180MB on the squashfs) and serve no purpose on the live system -- it
# re-fetches indices itself if the user installs anything post-boot.
rm -rf /var/lib/apt/lists/*
rm -f /var/cache/apt/*.bin
apt-get clean

# NVIDIA GPU firmware from firmware-misc-nonfree (~118MB). Tailboot never
# drives a display at any point in its boot, so this is dead weight
# regardless of what GPU the target hardware has.
rm -rf /usr/lib/firmware/nvidia
