#!/bin/sh

set -eu
umask 077

config=/run/live/medium/TAILBOOT.JSON

jq -r '.authKey' "${config}" > /run/tailboot/auth.key

# Wi-Fi and static IP are optional: an error or hang in either must not
# prevent Ethernet and Tailscale from starting. Keep auth-key extraction
# above outside this failure boundary.
if ! timeout --kill-after=1s 10s /usr/local/sbin/tailboot-wifi; then
  echo 'Tailboot Wi-Fi setup failed; continuing with Ethernet available.' >&2
fi

if ! timeout --kill-after=1s 10s /usr/local/sbin/tailboot-static-ip; then
  echo 'Tailboot static IP setup failed; continuing with DHCP.' >&2
fi
