#!/bin/sh

set -eu
umask 077

config=/run/live/medium/TAILBOOT.JSON

# hostname is precomputed server-side (sanitized, "dropbox-<client>") and
# runs before NetworkManager/tailscaled start, so `tailscale up`'s default
# device-naming picks it up. Wrapped so a failure here (the hostname command
# is the riskiest step in this script) can't cost the engagement.txt/scope
# CSV steps below, which are independent of it.
if jq -e '.hostname != null' "${config}" > /dev/null; then
  if ! (
    hostname_value=$(jq -r '.hostname' "${config}")
    printf '%s\n' "${hostname_value}" > /etc/hostname
    hostname "${hostname_value}"
  ); then
    echo 'Tailboot hostname setup failed; continuing with the default hostname.' >&2
  fi
fi

mkdir -p /root/scripts

# Reference-only: nothing on the box enforces the kill date.
engagement=/root/scripts/engagement.txt
rm -f "${engagement}"
if jq -e '.clientName != null' "${config}" > /dev/null; then
  printf 'Client: %s\n' "$(jq -r '.clientName' "${config}")" >> "${engagement}"
fi
if jq -e '.date != null' "${config}" > /dev/null; then
  printf 'Start date: %s\n' "$(jq -r '.date' "${config}")" >> "${engagement}"
fi
if jq -e '.killDate != null' "${config}" > /dev/null; then
  printf 'Kill date: %s\n' "$(jq -r '.killDate' "${config}")" >> "${engagement}"
fi
if [ ! -s "${engagement}" ]; then
  rm -f "${engagement}"
fi

# One file per distinct scope-list name (e.g. "Internal" -> internal.csv,
# "CDE" -> cde.csv), one target per line with no header so these drop
# straight into nmap/masscan -iL without editing. Two names that slugify the
# same (e.g. "External IPs" and "external ips") merge into one file rather
# than overwrite each other, since the file is selected by slug, not by
# original name.
slugify_filter='def slugify: ascii_downcase | gsub("[^a-z0-9-]+"; "-") | gsub("-{2,}"; "-") | gsub("^-+|-+$"; "");'
if jq -e '.scope != null' "${config}" > /dev/null; then
  if ! (
    # set -e does not apply to commands inside a subshell that is itself the
    # condition of `if !(...)` -- a failure here would otherwise be silently
    # swallowed, since the `for` loop below would then run zero times (empty
    # slugs) and exit 0 on its own, making the whole subshell look
    # successful. The explicit `|| exit 1` is what actually propagates the
    # failure. Slugs never contain whitespace, so the unquoted word-splitting
    # in the loop is safe (a pipe into `while` would mask a failure here too,
    # since dash has no pipefail).
    slugs=$(jq -r "${slugify_filter} [.scope[].name | slugify] | unique | .[]" "${config}") || exit 1
    for slug in ${slugs}; do
      [ -n "${slug}" ] || continue
      jq -r --arg slug "${slug}" \
        "${slugify_filter} .scope[] | select((.name | slugify) == \$slug) | .value" \
        "${config}" > "/root/scripts/${slug}.csv"
    done
  ); then
    echo 'Tailboot scope CSV generation failed.' >&2
  fi
fi
